<UserControl x:Class="FT_Inventory.MVVM.View.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             xmlns:viewModels="clr-namespace:FT_Inventory.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="720">
    <Grid Background="{StaticResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch"  Background="DarkOrange" Height="50">
            <TextBlock Text="Product Management" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5, 0, 0, 0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20, 0, 5, 0">
                <ComboBox Height="40" Width="100"
                          Style="{StaticResource ComboBoxFilterTheme}"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="PeachPuff"
                         Width="250"
                         Height="35"
                         Margin="10,0"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"/>
                <Button Content="➕ Add"
                        Style="{StaticResource EditButtonTheme}"
                        Command="{Binding DataContext.AddNewProductCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                        Height="40"
                        Width="80"
                        Margin="10,0"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                  Style="{StaticResource ProductsDataGridTheme}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="90"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat={}{0:0.00}}" Width="90"/>
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                <DataGridTextColumn Header="Updated At" Binding="{Binding UpdatedAt}" Width="150"/>
                <DataGridTemplateColumn Header="Actions" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✏ Edit"
                                        Style="{StaticResource EditButtonTheme}"
                                        Command="{Binding DataContext.SwitchToProductDetailsView, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="60"/>
                                <Button Content="🗑 Delete"
                                        Style="{StaticResource DeleteButtonTheme}"
                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="60"
                                        Margin="5,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
