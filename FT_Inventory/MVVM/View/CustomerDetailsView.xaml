<UserControl x:Class="FT_Inventory.MVVM.View.CustomerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             xmlns:base="clr-namespace:FT_Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">

    <Grid Background="{StaticResource BlackBrush}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Customer Details (Left Side) -->
        <GroupBox Header="Customer Information" Foreground="White" Grid.Row="0" Grid.Column="0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="ID:" Style="{StaticResource LabelStyleWhite}" Grid.Row="0" Grid.Column="0"/>
                <TextBlock Text="{Binding CurrentCustomer.Id}" Style="{StaticResource InputFieldUnfocusable}" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="First Name:" Style="{StaticResource LabelStyleWhite}" Grid.Row="1" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.FirstName}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Last Name:" Style="{StaticResource LabelStyleWhite}" Grid.Row="2" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.LastName}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Email:" Style="{StaticResource LabelStyleWhite}" Grid.Row="3" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.Email}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Phone:" Style="{StaticResource LabelStyleWhite}" Grid.Row="4" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.Phone}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="4" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- Image Section (Right Side) -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0, 10, 0, 0">
            <Border BorderBrush="{StaticResource GrayBrush}" BorderThickness="5" CornerRadius="5">
                <Image x:Name="CustomerImage" Source="{Binding CurrentCustomer.ImageUrl}" Width="200" Height="160"/>
            </Border>
            <Button Content="Upload Image"
                    Margin="10"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, 
                                      Path=DataContext.ChangeImageCommand}"
                    Style="{StaticResource BaseDetailsViewButton}"/>
        </StackPanel>

        <!-- Address Details -->
        <GroupBox Header="Address" Foreground="White" Grid.Row="1" Grid.Column="0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Address:" Style="{StaticResource LabelStyleWhite}" Grid.Row="0" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.Address}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="City:" Style="{StaticResource LabelStyleWhite}" Grid.Row="1" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.City}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="State:" Style="{StaticResource LabelStyleWhite}" Grid.Row="2" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.State}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Postal Code:" Style="{StaticResource LabelStyleWhite}" Grid.Row="3" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.PostalCode}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Country:" Style="{StaticResource LabelStyleWhite}" Grid.Row="4" Grid.Column="0"/>
                <TextBox Text="{Binding CurrentCustomer.Country}" Style="{StaticResource InputFieldsFocusable}" Grid.Row="4" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- Bottom Section (Created At, Updated At & Buttons) -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Created At:" Style="{StaticResource LabelStyleWhite}" Margin="0,5,5,5"/>
                <TextBlock Text="{Binding CurrentCustomer.CreatedAt}" Style="{StaticResource InputFieldUnfocusable}" Width="220"/>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Updated At:" Style="{StaticResource LabelStyleWhite}" Margin="0,5,5,5"/>
                <TextBlock Text="{Binding CurrentCustomer.UpdatedAt}" Style="{StaticResource InputFieldUnfocusable}" Width="220"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, 
                                      Path=DataContext.GoBackCommand}"/>
            <Button Content="Save" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, 
                                      Path=DataContext.SaveCustomerCommand}"
                    CommandParameter="{Binding CurrentCustomer}"/>
        </StackPanel>
    </Grid>
</UserControl>
