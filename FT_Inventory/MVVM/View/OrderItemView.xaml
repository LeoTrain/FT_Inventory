<UserControl x:Class="FT_Inventory.MVVM.View.OrderItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <Grid Background="{StaticResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Order Item Details" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>

        <!-- Main Layout -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side (Order Item Details) -->
            <Border BorderBrush="White" BorderThickness="1">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Order Item ID:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                        <TextBlock Text="{Binding CurrentOrderItem.OrderItemId}" Style="{StaticResource InputFieldUnfocusable}" Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Order ID:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                        <TextBlock Text="{Binding CurrentOrderItem.OrderId}" Style="{StaticResource InputFieldUnfocusable}" Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Quantity:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                        <TextBlock Text="{Binding CurrentOrderItem.Quantity}" Style="{StaticResource InputFieldUnfocusable}" Width="20" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Width="60">
                            <Button Content="+" Height="30" Width="30" Command="{Binding IncrementQuantityCommand}" FontSize="18" FontWeight="Bold"/>
                            <Button Content="-" Height="30" Width="30" Command="{Binding DecrementQuantityCommand}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Total Price:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                        <TextBlock Text="{Binding CurrentOrderItem.TotalPrice, StringFormat={}{0:C}}" Style="{StaticResource InputFieldUnfocusable}" FontSize="16" FontWeight="Bold" Foreground="Lime"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Side (Product Quick Info) -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Product Quick Info" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Product Name:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                    <ComboBox ItemsSource="{Binding AllProductsName}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" Width="230" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Product Price:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                    <TextBlock Text="{Binding CurrentOrderItem.Product.Price, StringFormat={}{0:C}}" Style="{StaticResource InputFieldUnfocusable}" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Stock Qty:" Style="{StaticResource LabelStyleWhite}" Width="150"/>
                    <TextBlock Text="{Binding CurrentOrderItem.Product.StockQuantity}" Style="{StaticResource InputFieldUnfocusable}" Width="50" TextAlignment="Center"/>
                </StackPanel>
                <Border BorderBrush="{StaticResource GrayBrush}" BorderThickness="5" CornerRadius="5" Padding="5" Margin="15, 5, 5, 5">
                    <Image x:Name="ProductImage" Source="{Binding CurrentOrderItem.Product.ImageUrl}" Width="250" Height="185" Stretch="Uniform"/>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Cancel" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.GoBackCommand}"/>
            <Button Content="Save" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.SaveOrderItemCommand}"
                    CommandParameter="{Binding CurrentOrderItem}"/>
        </StackPanel>
    </Grid>
</UserControl>
