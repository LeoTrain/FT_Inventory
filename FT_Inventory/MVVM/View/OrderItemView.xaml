<UserControl x:Class="FT_Inventory.MVVM.View.OrderItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression.blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <Grid Background="{StaticResource BlackBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Order Item Details" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>

        <!-- Form Section -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Order Item ID:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.OrderItemId}" Style="{StaticResource InputFieldUnfocusable}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Order ID:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.OrderId}" Style="{StaticResource InputFieldUnfocusable}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Product ID:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <ComboBox ItemsSource="{Binding AllProductsName}" 
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" 
                              Width="230"/>
                </StackPanel>

                <!-- Quantity Selection -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Quantity:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.Quantity}" 
                               Style="{StaticResource InputFieldUnfocusable}" 
                               Width="50" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Width="60">
                        <Button Content="+" Height="30" Width="30" 
                                Command="{Binding IncrementQuantityCommand}" 
                                FontSize="18" FontWeight="Bold"/>
                        <Button Content="-" Height="30" Width="30" 
                                Command="{Binding DecrementQuantityCommand}" 
                                FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Total Price -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Total Price:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.TotalPrice, StringFormat={}{0:C}}" 
                               Style="{StaticResource InputFieldUnfocusable}" 
                               FontSize="16" FontWeight="Bold" Foreground="Lime"/>
                </StackPanel>
            </StackPanel>


            <!-- Product Quick Tips -->
            <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Product Quick Info" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Product Name:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.Product.Name}" Style="{StaticResource InputFieldUnfocusable}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Product Price:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentOrderItem.Product.Price, StringFormat={}{0:C}}" 
                               Style="{StaticResource InputFieldUnfocusable}" 
                               FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Stock Quantity:" Style="{StaticResource LabelStyleWhite}" Width="140"/>
                    <TextBlock Text="{Binding CurrentProduct.StockQuantity}" 
                               Style="{StaticResource InputFieldUnfocusable}" 
                               Width="50" TextAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Cancel" Width="100" Height="35" Margin="10"
                    Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            <Button Content="Save" Width="100" Height="35" Margin="10"
                    Command="{Binding DataContext.SaveOrderItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding DataContext.CurrentOrderItem, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
        </StackPanel>
    </Grid>
</UserControl>

