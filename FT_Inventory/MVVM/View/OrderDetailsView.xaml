<UserControl x:Class="FT_Inventory.MVVM.View.OrderDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <Grid Background="{StaticResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Order Details (Left Side) -->
        <GroupBox Header="Order Information" Foreground="White" Grid.Row="0" Grid.Column="0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Order ID:" Style="{StaticResource LabelStyleWhite}" Grid.Row="0" Grid.Column="0"/>
                <TextBlock Text="{Binding CurrentOrder.OrderId}" Style="{StaticResource InputFieldUnfocusable}" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="Created At:" Style="{StaticResource LabelStyleWhite}" Grid.Row="1" Grid.Column="0"/>
                <TextBlock Text="{Binding CurrentOrder.CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource InputFieldUnfocusable}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Customer ID:" Style="{StaticResource LabelStyleWhite}" Grid.Row="2" Grid.Column="0"/>
                <ComboBox ItemsSource="{Binding AllCustomersName}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" Width="240" Margin="10,0" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Total Price:" Style="{StaticResource LabelStyleWhite}" Grid.Row="3" Grid.Column="0"/>
                <TextBlock Text="{Binding CurrentOrder.TotalPrice, StringFormat=\{0:C\}}" Style="{StaticResource InputFieldUnfocusable}" Grid.Row="3" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- Order Items -->
        <GroupBox Header="Order Items" Foreground="White" Grid.Row="1" Grid.Column="0" Padding="10">
            <Grid>
                <!-- ScrollViewer to make the ItemsControl scrollable -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="200" Width="375"
                              HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding CurrentOrder.OrderItems}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" Background="LightGray" Height="25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Product.Name}" Grid.Column="0" VerticalAlignment="Center" Padding="5"/>
                                    <TextBlock Text="{Binding OrderItemId}" Grid.Column="1" VerticalAlignment="Center" Padding="5"/>
                                    <TextBlock Text="{Binding Quantity}" Grid.Column="2" VerticalAlignment="Center" Padding="5"/>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat=\{0:C\}}" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5"/>
                                    <Button Content="Edit" 
                                    Command="{Binding DataContext.SwitchToOrderItemView, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" 
                                    CommandParameter="{Binding}" 
                                    Grid.Column="4" 
                                    Width="50" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteOrderItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="5"
                                            Width="50"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Content="Add Item" Command="{Binding DataContext.AddNewOrderItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" 
                        CommandParameter="{Binding CurrentOrder.OrderId}" HorizontalAlignment="Right" Width="50"/>
            </Grid>
        </GroupBox>

        <!-- Bottom Section (Created At, Updated At & Buttons) -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,19,2,0" Height="100">
            <TextBlock Text="Created At:" Style="{StaticResource LabelStyleWhite}" />
            <TextBlock Text="{Binding CurrentOrder.CreatedAt}" Style="{StaticResource InputFieldUnfocusable}" Width="220"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0, 20, 5, 0">
            <Button Content="Cancel" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor,
                                                      AncestorType={x:Type Window}}, 
                                      Path=DataContext.GoBackCommand}"/>
            <Button Content="Save" Style="{StaticResource BaseDetailsViewButton}" Width="100"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor,
                                                      AncestorType={x:Type Window}}, 
                                      Path=DataContext.SaveOrderCommand}"
                    CommandParameter="{Binding CurrentOrder}"/>
        </StackPanel>
    </Grid>
</UserControl>
