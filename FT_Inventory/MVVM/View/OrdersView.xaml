<UserControl x:Class="FT_Inventory.MVVM.View.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="720">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 0, 0, 10">
                <ComboBox Height="40" Width="50" VerticalAlignment="Bottom" Style="{StaticResource ComboBoxFilterTheme}">
                    <ComboBoxItem IsSelected="True">Id</ComboBoxItem>
                    <ComboBoxItem>Name</ComboBoxItem>
                    <ComboBoxItem>Price</ComboBoxItem>
                </ComboBox>

                <TextBox Width="400"
                     Height="40"
                     Margin="0, 20, 0, 0"
                     Grid.Column="1"
                     Style="{StaticResource ModernTextBox}"/>
                <Button Content="Add"
                        Style="{StaticResource EditButtonTheme}"
                        Foreground="{StaticResource WhiteBrush}"
                        Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                  AncestorType={x:Type Window}}, Path=DataContext.AddNewOrderCommand}"
                        CommandParameter="{Binding}"
                        Width="50"
                        Margin="10, 20, 0, 0"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                      Style="{StaticResource ProductsDataGridTheme}"
                      MaxHeight="400"
                      MaxWidth="700">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order Id" Binding="{Binding OrderId}" Width="60"/>
                    <DataGridTextColumn Header="Customer Id" Binding="{Binding Customer.Id}" Width="80"/>
                    <DataGridTextColumn Header="Creation Time" Binding="{Binding CreatedAt}" Width="130"/>
                    <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice}" Width="70"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Delete"
                                            Style="{StaticResource DeleteButtonTheme}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Width="50"
                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                            AncestorType={x:Type UserControl}}, Path=DataContext.DeleteOrderCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Edit"
                                            Style="{StaticResource EditButtonTheme}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Width="50"
                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                            AncestorType={x:Type Window}}, Path=DataContext.SwitchToOrderDetailsView}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>

    </Grid>
</UserControl>
