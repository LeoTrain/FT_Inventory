<UserControl x:Class="FT_Inventory.MVVM.View.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="720">
    <Grid Background="{StaticResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch"  Background="DarkOrange" Height="50">
            <TextBlock Text="Order Management" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5, 0, 0, 0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="150, 0, 0, 0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="PeachPuff"
                         Width="250"
                         Height="35"
                         Margin="10,0"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"/>
                <Button Content="➕ Add"
                        Style="{StaticResource EditButtonTheme}"
                        Command="{Binding DataContext.AddNewOrderCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                        Height="40"
                        Width="80"
                        Margin="10,0"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                  Style="{StaticResource ProductsDataGridTheme}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order Id" Binding="{Binding OrderId}" Width="70"/>
                <DataGridTextColumn Header="Customer Id" Binding="{Binding Customer.Id}" Width="100"/>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding Customer.FullName}" Width="150"/>
                <DataGridTextColumn Header="Creation Time" Binding="{Binding CreatedAt}" Width="140"/>
                <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="90"/>
                <DataGridTemplateColumn Header="Actions" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✏ Edit"
                                        Style="{StaticResource EditButtonTheme}"
                                        Command="{Binding DataContext.SwitchToOrderDetailsView, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="60"/>
                                <Button Content="🗑 Delete"
                                        Style="{StaticResource DeleteButtonTheme}"
                                        Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="60"
                                        Margin="5,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
