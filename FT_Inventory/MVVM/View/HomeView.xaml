<UserControl x:Class="FT_Inventory.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Text="Discover"
                      Foreground="Orange"
                      FontSize="28"
                      HorizontalAlignment="Left"
                      Margin="0, 0, 0, 20"/>

        <StackPanel Orientation="Horizontal">

            <Border Width="200"
                    Height="200"
                    CornerRadius="10"
                    Margin="50, 0, 0, 0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                        <GradientStop Color="{StaticResource ColorGray}" Offset="0.0"/>
                        <GradientStop Color="{StaticResource ColorBlack}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Hot Products"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="20, 10, 10, 0"
                                   FontFamily="/Fonts/Poppins/#Poppins"
                                   HorizontalAlignment="Center"/>
                    <Image Width="150"
                           Height="150"
                           Source="/Images/beer.png"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
