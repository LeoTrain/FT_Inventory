<UserControl x:Class="FT_Inventory.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid >
        <!-- Background dark for better contrast -->
        <!-- Header with title -->
        <StackPanel Margin="20">
            <TextBlock Text="Welcome to FT Inventory"
                       Foreground="Orange"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0, 0, 0, 13"/>
            <TextBlock Text="Manage your products, customers, orders and more in one place!"
                       Foreground="Gray"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0, 0, 0, 40"/>
        </StackPanel>

        <!-- Navigation buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 110, 0, 0">
            <Button Content="Products"
                    Width="120"
                    Height="40"
                    Background="Orange"
                    Foreground="White"
                    BorderBrush="Orange"
                    BorderThickness="1"
                    Margin="10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Command="{Binding DataContext.SwitchToProductsView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF8C00"/>
                                <Setter Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Customers"
                    Width="120"
                    Height="40"
                    Background="Orange"
                    Foreground="White"
                    BorderBrush="Orange"
                    BorderThickness="1"
                    Margin="10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Command="{Binding DataContext.SwitchToCustomerView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF8C00"/>
                                <Setter Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Orders"
                    Width="120"
                    Height="40"
                    Background="Orange"
                    Foreground="White"
                    BorderBrush="Orange"
                    BorderThickness="1"
                    Margin="10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Command="{Binding DataContext.SwitchToOrderView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF8C00"/>
                                <Setter Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Main Content Area with visual cards -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 140, 0, 0">
            <!-- Card for insights text -->
            <Border Width="300"
                    Height="150"
                    Background="#444444"
                    CornerRadius="10"
                    Margin="10"
                    Padding="10"
                    BorderBrush="Orange"
                    BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Gain insights into your business's performance and growth."
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Track sales trends, customer engagement, and overall efficiency."
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Width="300"
                    Height="150"
                    Background="#444444"
                    CornerRadius="10"
                    Margin="10"
                    Padding="10"
                    BorderBrush="Orange"
                    BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Make data-driven decisions and optimize your workflow."
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Visualize your business' key metrics and adapt accordingly."
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
