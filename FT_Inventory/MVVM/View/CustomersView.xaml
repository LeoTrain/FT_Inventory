<UserControl x:Class="FT_Inventory.MVVM.View.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FT_Inventory.MVVM.View"
             xmlns:base="clr-namespace:FT_Inventory"
             xmlns:viewModels="clr-namespace:FT_Inventory.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="720">

    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 0, 0, 10">
                <TextBox Width="400"
                     Height="40"
                     Margin="0, 20, 0, 0"
                     Grid.Column="1"
                     Style="{StaticResource ModernTextBox}"/>

                <Button Content="Add"
                        Style="{StaticResource EditButtonTheme}"
                        Foreground="{StaticResource WhiteBrush}"
                        Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                  AncestorType={x:Type Window}}, Path=DataContext.AddNewCustomerCommand}"
                        CommandParameter="{Binding}"
                        Width="50"
                        Margin="10, 20, 0, 0"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                      Style="{StaticResource ProductsDataGridTheme}"
                      MaxHeight="400"
                      MaxWidth="700">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="30"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="100"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="100"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="50"/>
                    <DataGridTextColumn Header="Postal Code" Binding="{Binding PostalCode}" Width="75"/>
                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="55"/>
                    <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" Width="150"/>
                    <DataGridTextColumn Header="Update At" Binding="{Binding UpdatedAt}" Width="150"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Delete"
                                            Style="{StaticResource DeleteButtonTheme}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Width="50"
                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                            AncestorType={x:Type UserControl}}, Path=DataContext.DeleteCustomerCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Edit"
                                            Style="{StaticResource EditButtonTheme}"
                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                            AncestorType={x:Type Window}}, Path=DataContext.SwitchToCustomerDetailsView}"
                                            CommandParameter="{Binding}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Width="50"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </Grid>
</UserControl>
