<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBlack">#222831</Color>
    <Color x:Key="ColorIntenseBlack">#1A1A1A</Color>
    <Color x:Key="ColorGray">#393E46</Color>
    <Color x:Key="ColorLightGray">#B0B0B0</Color>
    <Color x:Key="ColorSoftGray">#A6A6A6</Color>
    <Color x:Key="ColorBlueishGray">#2E3439</Color>
    <Color x:Key="ColorTeal">#00ADB5</Color>
    <Color x:Key="ColorDarkTeal">#00747A</Color>
    <Color x:Key="ColorPastelTeal">#80E1E5</Color>
    <Color x:Key="ColorLuminousTeal">#5FF1F5</Color>
    <Color x:Key="ColorWhite">#EEEEEE</Color>

    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource ColorBlack}" />
    <SolidColorBrush x:Key="IntenseBlackBrush" Color="{StaticResource ColorIntenseBlack}" />
    <SolidColorBrush x:Key="GrayBrush" Color="{StaticResource ColorGray}" />
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource ColorLightGray}" />
    <SolidColorBrush x:Key="SoftGrayBrush" Color="{StaticResource ColorSoftGray}" />
    <SolidColorBrush x:Key="BlueishGrayBrush" Color="{StaticResource ColorBlueishGray}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource ColorTeal}" />
    <SolidColorBrush x:Key="DarkTealBrush" Color="{StaticResource ColorDarkTeal}" />
    <SolidColorBrush x:Key="PastelTealBrush" Color="{StaticResource ColorPastelTeal}" />
    <SolidColorBrush x:Key="LuminousTealBrush" Color="{StaticResource ColorLuminousTeal}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource ColorWhite}" />

</ResourceDictionary>